OPENAI_API_KEY=put_your_api_key_here
OPENAI_COMPANION_MODEL=gpt-5.6-terra
OPENAI_ROUTER_MODEL=gpt-5.6-luna
OPENAI_AUDIO_MODEL=gpt-audio-1.5
# Fully local mode (OpenAI key is not required when these are enabled)
EMBER_AI_PROVIDER=ollama
EMBER_LOCAL_MODEL=ember-local
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
EMBER_TRANSCRIPTION_PROVIDER=local
EMBER_LOCAL_TRANSCRIPTION_MODEL=base.en
SPOTIFY_CLIENT_ID=put_your_spotify_client_id_here
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8765/callback
